# Variables serveur (jamais exposées au navigateur) — utilisées par les
# fonctions dans /api pour créer et vérifier le paiement de l'acompte.
# À définir dans les réglages Vercel du projet (Settings → Environment
# Variables), PAS dans ce fichier ni dans un .env commité.

# Clé secrète SumUp, à créer sur https://me.sumup.com
# (profil → Settings → For Developers → Toolkit → API Keys).
SUMUP_API_KEY=sup_sk_...

# Code marchand du profil SumUp d'Harmonie Group, visible dans les
# paramètres du compte SumUp.
SUMUP_MERCHANT_CODE=MC000000

# Clé service_role du projet Supabase harmonie-yacht — permet aux fonctions
# serveur d'écrire l'intention de réservation avant le paiement.
# Supabase → Project Settings → API → service_role.
SUPABASE_SERVICE_ROLE_KEY=eyJ...
